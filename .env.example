# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://user:password@host:5432/easyasso?sslmode=require"

# --- Auth (NextAuth) ---
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Root domain used to build free tenant subdomains (e.g. mon-asso.easy-asso.fr)
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"
# Price in euros for onboarding
NEXT_PUBLIC_PRICE_EUR="250"
# Set to "1" to bypass Stripe and allow demo activation without payment
DEMO_MODE="1"

# --- IA : générateur magique (optionnel) ---
# Si présent, le générateur rédige des textes riches avec Claude.
# Sinon, un générateur déterministe (sans IA) prend le relais automatiquement.
ANTHROPIC_API_KEY=""
# Modèle utilisé (défaut : claude-sonnet-5). Ex : claude-opus-5 pour + de qualité.
ANTHROPIC_MODEL="claude-sonnet-5"
# Clé "Access Key" Unsplash (gratuite : https://unsplash.com/developers).
# Si présente, chaque génération récupère de vraies photos thématiques de la
# cause (cohérentes + variées). Sinon, un jeu de photos sélectionnées est utilisé.
UNSPLASH_ACCESS_KEY=""

# --- Stripe (optional in demo mode) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRICE_ID=""

# --- Domaines personnalisés (Vercel) ---
# Jeton limité à l’équipe/projet EasyAsso. Il sert uniquement à ajouter le
# domaine d’une association comme adresse secondaire du projet.
VERCEL_API_TOKEN=""
VERCEL_PROJECT_ID=""
VERCEL_TEAM_ID=""

# --- Airwallex (paiement EasyAsso de 250 EUR) ---
# Clé serveur limitée à Payment Links (lecture + écriture).
AIRWALLEX_CLIENT_ID=""
AIRWALLEX_API_KEY=""
AIRWALLEX_WEBHOOK_SECRET=""
AIRWALLEX_API_URL="https://api.airwallex.com/api/v1"
